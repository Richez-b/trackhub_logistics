{% extends "trackhub/partials/base_connected.twig" %}

{% block content %}
  <div class="container">
    <h1 class="trackhub_title">Toutes vos positions</h1>
  </div>
  <div class="container mb-5" style="width: 500px;">
    <div class="card">
      <h5 class="mt-3 text-center">Rechercher une position</h5>
      <form action="" class="p-3">
        <div class="input-group mb-3">
          <label for="" class="input-group-text">N° de récepissé</label>
          <input type="number" class="form-control" placeholder="Ex :123011">
        </div>
        <div class="input-group mb-3">
          <label for="" class="input-group-text">Nom expéditeur</label>
          <input type="text" class="form-control" placeholder="Ex :Dupont">
        </div>
        <div class="input-group mb-3">
          <label for="" class="input-group-text">Nom destinataire</label>
          <input type="text" class="form-control" placeholder="Ex :123011">
        </div>
        <div class="input-group mb-3">
          <label for="" class="input-group-text">Date de livraison</label>
          <input type="number" class="form-control" placeholder="Ex :123011">
        </div>
      </form>
      <div class="row mb-3">
        <div class="col-6 d-flex justify-content-end">
          <a href="" class="btn btn-danger">Effacer</a>
        </div>
        <div class="col-6 d-flex justify-content-start">
          <a href="" class="btn btn-success">Rechercher</a>
        </div>
      </div>
    </div>
  </div>
  <hr>
  <div class="container mt-5">
      <table class="table text-center">
          <thead>
              <tr>
                  <th>Nom expéditeur</th>
                  <th>Numéro de récépissé</th>
                  <th>Date de livraison</th>
                  <th>Nom destinataire</th>
